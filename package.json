{
  "name": "@frank.md93/core-react-library",
  "version": "0.2.1",
  "type": "module",
  "description": "A set of React tools: HTTP hooks, dynamic remote module loaders and TypeScript utilities.",
  "author": "Francesco Murador",
  "license": "MIT",
  "homepage": "https://github.com/frax93/core-react-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frax93/core-react-library.git"
  },
  "bugs": {
    "url": "https://github.com/frax93/core-react-library/issues"
  },
  "keywords": [
    "react",
    "react-hooks",
    "typescript",
    "http",
    "axios",
    "module-federation",
    "web-components",
    "utils"
  ],
  "main": "core-react-library.cjs",
  "module": "core-react-library.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./core-react-library.js",
      "require": "./core-react-library.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "peerDependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "axios": "^1.10.0",
    "mitt": "^3.0.1",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.10.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.1",
    "rollup": "^4.44.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
